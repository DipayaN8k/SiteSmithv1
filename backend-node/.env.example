# Copy to .env for local development. On Hostinger set these in the web app's Environment variables
# instead (hPanel). Never commit .env.

# development | production. "production" refuses to start with a weak JWT_SECRET, SQLite or empty CORS_ORIGINS.
NODE_ENV=development

# Port to listen on locally (the website and dashboard expect 8000). Hostinger provides PORT itself; leave it unset there.
PORT=8000

# --- Database -------------------------------------------------------------------------------------
# Production: MySQL created in hPanel (Databases -> MySQL Databases). Use 127.0.0.1, not "localhost"
# (Node resolves localhost to IPv6 and the connection can be refused).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Alternative to the DB_* values: DATABASE_URL=mysql://user:password@127.0.0.1:3306/dbname
# Local development without MySQL (built-in SQLite, needs Node 22.5+; never allowed in production):
# DATABASE_URL=sqlite:./dev.db

# --- Auth -----------------------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# --- Web ------------------------------------------------------------------------------------------
# Comma-separated exact origins of the website and dashboard (https, no trailing slash, no path).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# How many reverse proxies sit in front of the app (used to find the real visitor IP for rate limits).
TRUST_PROXY_HOPS=1

# --- Optional -------------------------------------------------------------------------------------
# CONTACT_RATE_LIMIT=5/hour
# LOGIN_RATE_LIMIT=10/minute
# RATE_LIMIT_ENABLED=true
# EMAIL_CHECK_DELIVERABILITY=true
# AUTO_MIGRATE=true
