# Copy to .env and edit. Never commit .env.

# dev | staging | prod. staging/prod refuse to start with a weak JWT_SECRET, SQLite, or empty CORS_ORIGINS.
ENV=dev

# Local dev: SQLite file. Production: PostgreSQL URL from your host (postgres:// is accepted).
DATABASE_URL=sqlite:///./dev.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# Comma-separated: landing site + admin dashboard origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional rate-limit overrides
# CONTACT_RATE_LIMIT=5/hour
# LOGIN_RATE_LIMIT=10/minute
